{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_BASE_URL": "https://api.fangnale.cn",
        "EXPO_PUBLIC_API_BASE": "https://api.fangnale.cn"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
